# systemd unit for the flock-off API. systemd is the program that runs
# everything on a Linux box; giving it this file makes the API a managed
# service: started at boot, restarted if it crashes, logs collected
# (journalctl -u flock-off), stopped/started with one command.
#
# Install: copy to /etc/systemd/system/flock-off.service, then:
#   systemctl daemon-reload
#   systemctl enable --now flock-off

[Unit]
Description=flock-off API (uvicorn)
# Don't start until the network is actually up, or the first DB connect
# would fail at boot.
After=network-online.target
Wants=network-online.target

[Service]
# Runs as the unprivileged app user, never root: a bug in the app can
# then only touch /opt/flock-off, not the rest of the machine.
User=flockoff
WorkingDirectory=/opt/flock-off/backend
# Secrets stay in .env (chmod 600). Unit files are world-readable, so
# nothing secret may ever be written into this file itself.
EnvironmentFile=/opt/flock-off/.env
# Full path into the venv - services get no shell, so no "activate".
# --host 127.0.0.1: invisible from the internet; Caddy is the front door.
# --proxy-headers + --forwarded-allow-ips 127.0.0.1: trust the
#   X-Forwarded-For header, but only when Caddy (localhost) sends it, so
#   the rate limiter sees each phone's real IP and outsiders can't spoof.
# No --workers flag: the rate limiter counts requests in process memory,
#   and multiple workers would each keep their own, wrongly looser, count.
# --no-access-log: the default access log would write every request line -
#   /search query strings and client IPs included - into the journal on
#   disk, which the privacy policy promises not to do. Errors still log.
ExecStart=/opt/flock-off/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=3

[Install]
# "enable" hooks the service into the normal multi-user boot sequence.
WantedBy=multi-user.target
