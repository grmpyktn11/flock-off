# Caddy is the front door: it owns ports 80/443, fetches and renews the
# HTTPS certificate from Let's Encrypt on its own (that is why the DNS A
# record must already point here), and forwards every request to the
# backend, which listens only on localhost and is never exposed directly.
#
# Replace YOUR.DOMAIN with the real domain, then install with:
#   cp infra/deploy/Caddyfile /etc/caddy/Caddyfile
#   systemctl reload caddy

YOUR.DOMAIN {
    reverse_proxy 127.0.0.1:8000
}
